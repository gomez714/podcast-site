# Public, non-secret configuration. Copy to .env.local to override locally.
# Canonical site origin used for metadata, Open Graph URLs and (later) the sitemap.
NEXT_PUBLIC_SITE_URL=https://bottomleftpane.com

# Podcast feed used by `npm run sync:episodes` and the footer RSS link.
PODCAST_RSS_URL=https://app.fusebox.fm/data/show/4YWVnlrWo1/feed
